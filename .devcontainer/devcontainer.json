{
  "name": "Car Information System",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [3000, 5000, 9000, 9001, 27017],
  "portsAttributes": {
    "3000": { "label": "Frontend (Next.js)" },
    "5000": { "label": "Backend API dan Swagger" },
    "9000": { "label": "MinIO API" },
    "9001": { "label": "MinIO Console" },
    "27017": { "label": "MongoDB" }
  },
  "postAttachCommand": "echo 'Jalankan: docker compose up --build'"
}
